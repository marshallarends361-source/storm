{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "product_id",
    "rating",
    "text"
  ]
}